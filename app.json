{
  "expo": {
    "name": "Task Pulse",
    "slug": "task-pulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/screen.png",
    "scheme": "taskpulse",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fbf6fb",
        "foregroundImage": "./src/assets/screen.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ishida24.taskpulse"
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/screen.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fbf6fb",
          "image": "./src/assets/screen.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
